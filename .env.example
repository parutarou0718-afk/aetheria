# Server-owned AI Gateway upstreams. Never expose these credentials to clients.
AETHERIA_UPSTREAM_1_ID="primary"
AETHERIA_UPSTREAM_1_BASE_URL="https://api.openai.com/v1"
AETHERIA_UPSTREAM_1_API_KEY=""
AETHERIA_UPSTREAM_1_MODELS="standard-model,advanced-model,deep-model"
AETHERIA_UPSTREAM_1_PRIORITY="1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
